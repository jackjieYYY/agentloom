# Before first startup: node --import tsx scripts/init-env.ts
# Generates local credentials in .env once; preserves existing credentials.
# Keep .env with the database volume; losing it does not reset the DB password.
# For an external DB, set DATABASE_URL yourself. Never commit real credentials.
POSTGRES_PASSWORD=
DATABASE_URL=
HOST=127.0.0.1
PORT=3000
LANGSMITH_TRACING=false