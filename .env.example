# Before first startup: node --import tsx scripts/init-env.ts
# Generates independent DB, JWT and model encryption secrets once; preserves existing values.
# Keep .env with the database volume; losing it does not reset the DB password.
# Back up MODEL_CREDENTIALS_KEY separately from the DB; never commit real credentials.
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_JWT_SECRET=
# Optional for read-only operation; required to encrypt/decrypt provider credentials.
# MODEL_CREDENTIALS_KEY must be 64 hexadecimal characters.
MODEL_CREDENTIALS_KEY=
# Provider credentials and model choices live in PostgreSQL; see docs/model-configuration.md.
# AGENT_MODEL_CALL_LIMIT=10
# AGENT_TOOL_CALL_LIMIT=20
# AGENT_TIMEOUT_MS=120000
