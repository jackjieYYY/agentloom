{
  "name": "myagents-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "vitest run --exclude 'tests/**/*.integration.test.ts'",
    "test:integration": "pnpm build && vitest run tests/*.integration.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/autoload": "6.5.1",
    "@fastify/cors": "11.4.1",
    "@langchain/core": "1.3.5",
    "@langchain/langgraph": "1.7.3",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/langgraph-sdk": "^1.15.0",
    "@langchain/openai": "1.8.2",
    "deepagents": "1.16.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "jose": "6.2.17",
    "langchain": "1.6.3",
    "langsmith": "0.9.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.4"
  }
}
